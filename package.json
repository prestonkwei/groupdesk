{
  "name": "tickets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "gmail:watch": "tsx --require ./scripts/shims.cjs scripts/gmail-watch.ts",
    "gmail:sync": "tsx --require ./scripts/shims.cjs scripts/gmail-sync.ts",
    "gmail:backfill": "tsx --require ./scripts/shims.cjs scripts/gmail-backfill.ts",
    "test": "pnpm typecheck && pnpm lint && pnpm test:ingest",
    "test:ingest": "tsx --require ./scripts/shims.cjs scripts/ingest-test.ts",
    "db:verify": "tsx scripts/db-verify.ts"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@googleapis/gmail": "^22.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "mimetext": "^3.0.28",
    "next": "^16.3.5",
    "postal-mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
