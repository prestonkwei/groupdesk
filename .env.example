# ---------------------------------------------------------------- database
# Neon pooled connection string (the one with -pooler in the host).
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------- app
APP_URL=https://tickets.example.org

# --------------------------------------------------------- google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to $APP_URL/api/admin/gmail/callback; set explicitly for local dev.
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------- pub/sub
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-tickets
GMAIL_PUSH_AUDIENCE=https://tickets.example.org/api/gmail/push
GMAIL_PUSH_SA_EMAIL=gmail-push-invoker@your-gcp-project.iam.gserviceaccount.com

# --------------------------------------------------------------- gmail
GMAIL_LABEL_NAME=helpdesk
GROUP_EMAIL=help@example.org

# -------------------------------------------------------------- secrets
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --------------------------------------------------- cloudflare access
# e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The Application Audience (AUD) tag from the Access application.
CF_ACCESS_AUD=

# ----------------------------------------------------------- storage
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------ alerts
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=

# -------------------------------------------------------- local only
# Acts as the signed-in agent when Cloudflare Access is not in front of the app.
# Ignored entirely when NODE_ENV=production.
DEV_BYPASS_EMAIL=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
