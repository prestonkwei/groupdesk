# ---------------------------------------------------------------- database
# Neon pooled connection string (the one with -pooler in the host).
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------- app
APP_URL=https://tickets.example.org

# ------------------------------------------------------------- branding
# Shown in page titles, the sidebar and automated mail. NEXT_PUBLIC_ values are
# baked in at build time, so redeploy after changing them.
NEXT_PUBLIC_APP_NAME=Tickets
# How agents sign replies, and the name on the satisfaction survey.
NEXT_PUBLIC_TEAM_NAME=Support Team
# The word in every reply's subject tag: "[TICKET: #1234] Subject". Changing it
# on a live deployment stops replies to older tags from matching by subject.
NEXT_PUBLIC_TICKET_TAG=TICKET
# Time zone for dates and reply targets, and the hours that count toward them.
NEXT_PUBLIC_TIME_ZONE=America/Los_Angeles
NEXT_PUBLIC_SCHOOL_HOURS=08:00-16:00

# --------------------------------------------------------- google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to $APP_URL/api/admin/gmail/callback; set explicitly for local dev.
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------- pub/sub
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-tickets
GMAIL_PUSH_AUDIENCE=https://tickets.example.org/api/gmail/push
GMAIL_PUSH_SA_EMAIL=gmail-push-invoker@your-gcp-project.iam.gserviceaccount.com

# --------------------------------------------------------------- gmail
# The Gmail label your filter applies to group mail; must match exactly.
GMAIL_LABEL_NAME=Tickets
# The only mailbox that may be connected, and the only person who sees /admin/gmail.
GMAIL_MAILBOX=you@example.org
# The Google Group requesters write to; replies are sent as this address.
GROUP_EMAIL=help@example.org

# -------------------------------------------------------------- secrets
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ------------------------------------------------------------- sign-in
# Any OpenID Connect provider (Google, Microsoft Entra ID, Okta, Auth0,
# Keycloak, your own...). Register a web app there with the redirect URI
# $APP_URL/api/auth/callback. The issuer is the URL that serves
# /.well-known/openid-configuration, e.g. https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only).
OIDC_CLIENT_SECRET=
# Defaults to "openid email profile".
OIDC_SCOPES=
# Signs the session cookie; at least 32 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ----------------------------------------------------------- storage
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------ alerts
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=

# -------------------------------------------------------- local only
# Acts as the signed-in agent when OIDC sign-in is not configured.
# Ignored entirely when NODE_ENV=production.
DEV_BYPASS_EMAIL=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Set to 1 to stop emailing requesters the 👍/👎 survey when a ticket is solved.
CSAT_DISABLED=
